# CYT-Common 测试服环境变量样例。
# 实际文件在服务器的 /opt/1panel/docker/compose/common-java/.env（权限 600，不进仓库）。
# 首次部署由 redeploy.sh 自动生成随机值；之后不会再覆盖，改密码请手动改这个文件。
#
# 生成随机值：openssl rand -hex 32

# ── 镜像与端口 ──
COMMON_JAVA_IMAGE=192.168.1.182:5000/cyt-common-java:latest
# 8081/8082 marketing，8083 marketing-web，8084 cs-web，8085 旧 common-api，
# 8086 cs-api，8087 portal —— 本服务用 8088，别和它们撞。
APP_PORT=8088
APP_ENV=test

# ── 专用 MySQL 8 容器 ──
# Docker Hub 拉不动时改成镜像站前缀，例如 docker.m.daocloud.io/mysql:8.0
MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=cyt_common
MYSQL_USER=cyt_gateway
MYSQL_PASSWORD=改成随机值
MYSQL_ROOT_PASSWORD=改成随机值

# ── 管理后台 ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=改成登录密码
# 至少 32 字符；换了会让已登录的会话失效
ADMIN_JWT_SECRET=改成至少32位随机值
# 上游凭据 Fernet 加密主密钥；换了旧凭据就解不开，别随意改
CREDENTIAL_MASTER_KEY=改成随机值

# ── 测试服开关 ──
# true = 不连任何真实供应商账号，页面照常可用；生产必须为 false
MOCK_ALL=true
JAVA_SEED_ENABLED=true
GATEWAY_DEV_MODE=false
