  "$collection": {
    "type": "object",
    "description": "",
    "properties": {
      "items": {
        "type": "array",
        "description": "已采集的根记录",
        "items": {
          "description": "来源记录，具体字段取决于被汇总的平台接口"
        }
      },
      "folders": {
        "type": "array",
        "description": "目录条目；部分来源不提供",
        "items": {
          "description": "目录信息，按来源接口返回"
        }
      },
      "errors": {
        "type": "array",
        "description": "部分记录读取失败的信息",
        "items": {
          "description": "单条读取失败的标识和错误信息"
        }
      },
      "partial": {
        "type": "boolean",
        "description": "是否存在部分失败或尚未完成的范围"
      },
      "coverage": {
        "type": "string",
        "description": "采集范围说明；root_records 不承诺已遍历全部嵌套资源"
      },
      "page": {
        "type": "object",
        "description": "",
        "properties": {
          "has_more": {
            "type": "boolean",
            "description": "是否还有待继续采集的数据"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "下次续传游标；继续时保持原筛选和 page_size"
          },
          "count": {
            "type": "integer",
            "description": "本次返回的记录数量"
          },
          "pages": {
            "type": "integer",
            "description": "本次已读取的上游页数"
          }
        }
      }
    }
