# Copy to application-local.properties; never commit real credentials.
server.address=127.0.0.1
server.port=8189
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/cyt_common_api_java?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
spring.datasource.username=cyt_gateway
spring.datasource.password=
ENV=local
MOCK_ALL=true
GATEWAY_DEV_MODE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
CREDENTIAL_MASTER_KEY=

# Explicit trusted internal service origins; empty keeps private networks blocked.
INTERNAL_API_ALLOWED_ORIGINS=
